# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/flowtera

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT secret — generate with: openssl rand -hex 64
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# App URL (used in email links)
APP_URL=http://localhost:3000

# SMTP (Brevo or any provider)
FROM_EMAIL=noreply@flowtera.app
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WebSocket URL — must match frontend VITE_WS_URL
WS_URL=http://localhost:3001

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# DB connection pool
DATABASE_POOL_LIMIT=10
DATABASE_SSL=false

# Redis cache (optional)
REDIS_URL=redis://localhost:6379

# AWS S3 for receipt storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=eu-central-1
AWS_S3_BUCKET=flowtera-receipts
AWS_S3_UPLOAD_EXPIRES=300

# Python ML service URL
PYTHON_ML_URL=http://localhost:8000

# Set to true to skip email OTP verification in development
SKIP_EMAIL_OTP=false

# Shared secret — must match api-gateway and python-ml
INTERNAL_API_KEY=change-me
