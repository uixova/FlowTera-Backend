# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/flowtera

# Shared secret — must match api-gateway and node-core
INTERNAL_API_KEY=change-me

# Service settings
PORT=8000
NODE_SERVICE_URL=http://localhost:3001

# Google Gemini (primary OCR provider)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Fallback model if primary quota exhausted (optional)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# OpenAI (fallback OCR provider — used if Gemini fails or key missing)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DB connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10
